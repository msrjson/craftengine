"""Event service provider.

Map this application's events to their listeners here. Intentionally empty: a
fresh project has no events yet.
"""

from craft.providers import ServiceProvider


class EventServiceProvider(ServiceProvider):
    """Registers this application's event listeners."""

    def register(self) -> None:
        """Bind event bindings into the container."""

    def boot(self) -> None:
        """Attach listeners once every provider has registered."""
