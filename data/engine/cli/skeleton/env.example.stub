APP_NAME=Craft
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en

# Signs session cookies. Generate one with: python dev.py key:generate
# Without it the framework falls back to a random per-process key, so sessions
# do not survive a restart and are not shared between workers.
APP_KEY=

# Database - sqlite | pgsql | mysql
# SQLite works with zero setup. For PostgreSQL, uncomment the block below
# (DB_DATABASE doubles as the SQLite file path, so only set it here when
# using a server driver). Values match `docker-compose.yml`'s `db` service -
# use DB_HOST=127.0.0.1 when running `dev.py` on the host against the
# containerized database; use DB_HOST=db only from inside the `app` container
# (docker-compose.yml sets that for you already).
DB_CONNECTION=sqlite
#DB_CONNECTION=pgsql
#DB_HOST=127.0.0.1
#DB_PORT=5499
#DB_DATABASE=craft_db
#DB_USERNAME=craft
#DB_PASSWORD=secretpassword

# Session - cookie (payload in a signed cookie) | file (payload on disk)
SESSION_DRIVER=cookie
SESSION_LIFETIME=7200
SESSION_COOKIE=craft_session
SESSION_SAME_SITE=lax
# Turn this on in production so the cookie is HTTPS-only.
SESSION_SECURE_COOKIE=false
# Only disable for a fully stateless API.
SESSION_CSRF=true

# Cache - array | file | redis
CACHE_DRIVER=array

# Queue - sync (run inline) | database
QUEUE_CONNECTION=sync

# Redis (only needed for CACHE_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Health probes - off until asked for. /ready answers only {"status": ...}
# unless the caller presents HEALTH_READINESS_TOKEN as a bearer token; the
# driver, cache store and pool census are never public. Optional: empty means
# everyone gets the reduced payload.
HEALTH_ROUTES_ENABLED=false
HEALTH_READINESS_TOKEN=
HEALTH_READINESS_CACHE_SECONDS=5

# Prometheus scrape endpoint - off until asked for. METRICS_TOKEN guards it.
METRICS_ENABLED=false

# MSR JSON manifest at /.well-known/msr.json (https://msrjson.org) - see config/msr.py
# Off until asked for: it publishes the exact version of this installation.
# Empty values are omitted from the manifest, never guessed. A localhost URL
# disables it until MSR_DOMAIN (or APP_URL) names the public domain.
MSR_ENABLED=false
MSR_DOMAIN=
MSR_TYPE=saas
MSR_DEPLOYMENT=cloud
MSR_LICENSE_TYPE=
MSR_LICENSE_SPDX=
MSR_LICENSE_TERMS=
MSR_VENDOR_NAME=
MSR_VENDOR_COUNTRY=
MSR_SUPPORT_URL=
MSR_PRICING_MODEL=
MSR_INTEGRATIONS=
