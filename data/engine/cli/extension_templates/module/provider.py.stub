"""Wire the __SLUG__ module: bindings, listeners, filters and proxy exposures.

Everything goes through `context`, so deactivating the module undoes it in the
running process (ADR 0004).
"""

from craft.extensions.context import ExtensionContext

from .services.__SLUG___service import __CLASS__Service


def register(context: ExtensionContext) -> None:
    """Bind the module's service and expose it to other modules.

    Args:
        context: The module's `ExtensionContext`.
    """
    context.app.singleton(__CLASS__Service, lambda container: __CLASS__Service())
    context.expose("__SLUG__", __CLASS__Service, {"summary"})
