# Environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Storage — the directories are tracked, their contents are not
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/app/*
!storage/**/.gitkeep
*.sqlite
*.sqlite3

# Scratch space
scratch/
*.log

# Test coverage data, written by `pytest --cov` on every run
.coverage
.coverage.*

# Agent harness state
.claude/

# Agent working directory — lives at the workspace root, outside data/
.agents/

# Node
node_modules/

# Documentation site, generated by dev.py docs:build. The source is
# documentation/*.md; this is output, and output does not belong in git.
public/docs/
