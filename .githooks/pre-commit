#!/bin/sh
# Workspace gates (never bypassed): the backlog queue (BQ-10) and the team board (append-only).
# Enable once per clone: git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -q '^backlog/'; then
    python3 "$root/.claude/rules/lint_backlog.py" --staged || exit 1
fi
if echo "$staged" | grep -q 'team/board.md$'; then
    python3 "$root/.claude/rules/lint_board.py" --staged || exit 1
fi
exit 0
